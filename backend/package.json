{
  "name": "revenuepilot-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "prisma:validate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js validate",
    "prisma:generate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate deploy",
    "db:status": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate status",
    "db:check": "tsx --env-file-if-exists=.env src/scripts/check-database.ts",
    "woo:check": "tsx --env-file-if-exists=.env src/scripts/check-woocommerce.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:woocommerce": "node --import tsx --test test/woocommerce.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
