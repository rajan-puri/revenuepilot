PORT=4000
# Exact allowed browser origins, comma-separated; no wildcard.
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
# Placeholder only: replace all uppercase fields in your ignored .env file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
# Direct Neon connection for Prisma migrations and other session-based tools.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?schema=public

# Backend-only WooCommerce REST API access. Use a read-only API key and HTTPS.
# Never expose these values through VITE_ variables or browser code.
WOOCOMMERCE_STORE_URL=https://store.example.com
WOOCOMMERCE_CONSUMER_KEY=ck_REPLACE_WITH_READ_ONLY_KEY
WOOCOMMERCE_CONSUMER_SECRET=cs_REPLACE_WITH_READ_ONLY_SECRET
